# Copy this file to .env (or run `python setup_credentials.py`) and fill it in.
# Get these values from https://developer.spotify.com/dashboard -> your app -> Settings.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret

# Must match a Redirect URI registered in the Spotify dashboard EXACTLY.
# Spotify no longer accepts "localhost"; use the loopback IP instead.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Signs the Flask session cookie. Any long random string works.
FLASK_SECRET_KEY=change-me

# Where to get tempo/key/energy from: auto | spotify | reccobeats
#   spotify    -> Spotify's /audio-features (only works for apps approved before Nov 2024)
#   reccobeats -> free third-party API that accepts Spotify track IDs
#   auto       -> try Spotify first, fall back to ReccoBeats on 403
FEATURES_PROVIDER=auto
